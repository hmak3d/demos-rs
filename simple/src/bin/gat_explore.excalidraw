      "link": null,
      "locked": false,
      "text": "Vec NOT == Vec<T>\n* Vec (the type constructor) has kind = type -> type\n* Vec<T> (its application) has kind = type\n* Vec<i32> and Vec<T> both have kind = type",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "KIB5V3skTnAgZEDzzwTQz",
      "originalText": "Vec NOT == Vec<T>\n* Vec (the type constructor) has kind = type -> type\n* Vec<T> (its application) has kind = type\n* Vec<i32> and Vec<T> both have kind = type",
      "autoResize": true,
      "lineHeight": 1.25
    }
